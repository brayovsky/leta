{
  "hosting": {
    "public": "public",
    "cleanUrls": true,
    "trailingSlash": false,
    "rewrites": [
      {
        "source": "/api/**",
        "run": {
          "serviceId": "leta-wa-hook",
          "region": "europe-west1"
        }
      },
      {
        "source": "/portal/**",
        "destination": "/portal/index.html"
      },
      {
        "source": "/checkout/**",
        "destination": "/checkout/index.html"
      },
      {
        "source": "/**",
        "run": {
          "serviceId": "leta-site",
          "region": "europe-west1"
        }
      }
    ]
  }
}
